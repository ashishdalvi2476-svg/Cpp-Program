#include <iostream>
using namespace std;
// Structure Decleration 
struct student{
    int roll;
    char name[50];
};
//Passing structure to function by value 
void display_1(student q){
    cout<<q.roll<<endl;
    cout<<q.name<<endl;
}
//Passing structure to function by refrence 
void display(student* s){
    s->roll=112;
    cout<<s->roll<<endl;
    cout<<s->name<<endl;
    
}
int main() {
    struct student s1={005,"Ashish"};
    struct student s2={002,"om"};
    display(&s1);
    display_1(s2);
}
