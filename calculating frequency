#include <iostream>
using namespace std;
int main()
{
    int n;
    cin>>n;
    int arr[n],fre[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    for(int i=0;i<n;i++){
         fre[n]=-1; 
    }
   
    
    for(int i=0;i<n;i++){
        int count=1;
        for(int j =i+1;j<n;j++){
        if(arr[i]==arr[j]){
            count++;
            fre[j]=0;
        }
    }
       if(fre[i]!=0){
        fre[i]=count;
        
    }
    }
    
    for(int i=0;i<n;i++){
        if(fre[i]!=0){
        cout<<arr[i]<<" "<<fre[i]<<endl;
        } 
    }
    
    
}
