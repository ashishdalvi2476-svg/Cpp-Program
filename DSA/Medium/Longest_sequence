// Approach - I

int lengthOfLongestConsecutiveSequence(vector<int> &arr, int n) {
   int cnt=0,last_min=INT_MIN;
   int longest=1;

   sort(arr.begin(),arr.end());

    for(int i=0;i<n;i++){
        if(arr[i]-1==last_min){
            cnt+=1;
            last_min=arr[i];
        }
        else if(arr[i]!=last_min){
            cnt=1;
            last_min=arr[i];
        }

        longest=max(longest,cnt);
    }

   return longest;
}

// Approach - II

int lengthOfLongestConsecutiveSequence(vector<int> &arr, int n) {
    if(n==0){ return 0; }
    int longest=1;

    unordered_set<int> st;
    for(int i=0;i<n;i++){
        st.insert(arr[i]);
    }

    for(auto it:st){
        if(st.find(it-1)==st.end()){
            int cnt=1;
            int x=it;
            while(st.find(x+1)!=st.end()){
                cnt+=1;
                x=x+1;
            }

            longest=max(longest,cnt);
        }

    }

    return longest;
}
