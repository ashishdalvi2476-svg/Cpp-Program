// Approach - I
class Solution {
public:

    void recursive(vector<int>& nums, vector<vector<int>>& ans,vector<int>& temp,int fre[],int n){
        if(temp.size()==n){
            ans.push_back(temp);
            return;
        }

        for(int i=0;i<n;i++){
            if(!fre[i]){
                temp.push_back(nums[i]);
                fre[i]=1;
                recursive(nums,ans,temp,fre,n);
                fre[i]=0;
                temp.pop_back();
            }
        }
    }
    
    vector<vector<int>> permute(vector<int>& nums) {
        int n=nums.size();
         vector<vector<int>> ans;
         vector<int> temp;
         int fre[n];
         for(int i=0;i<n;i++){ fre[i]=0; }

         recursive(nums,ans,temp,fre,n);

         return ans;
    }
};


// Approach - II

#include <bits/stdc++.h> 

void approach_ii(vector<int>& vec,int size,vector<vector<int>>& ans,int idx){
    if(idx==size){
        ans.push_back(vec);
        return;
    }

    for(int i=idx;i<size;i++){
        swap(vec[idx],vec[i]);
        approach_ii(vec,size,ans,idx+1);
        swap(vec[idx],vec[i]);
    }
}

vector<vector<int>> permutations(vector<int> &vec, int size) {
   vector<vector<int>> ans;
    
    approach_ii(vec,size,ans,0);
   return ans;
}
