#include <iostream>
using namespace std;
int main() {
    string s="ashish";
    string p=s;
    int st=0,end=s.length()-1;
    while(st<end){
        swap(s[st],s[end]);
        st++;
        end--;
    }
    if(s==p){
        cout<<"pallindrome"<<endl;
    }
    else{
        cout<<"Not Pallindrome"<<endl;
    }
}
