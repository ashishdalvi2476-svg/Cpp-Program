// Brute Force

#include <bits/stdc++.h>

int subarraysXor(vector<int> &arr, int x)
{
   int cnt=0;
   int n=arr.size();

   for(int i=0;i<n;i++){
       int XOR=0;
       for(int j=i;j<n;j++){
           XOR^=arr[j];

           if(XOR==x){ ++cnt; }
       }
   }

   return cnt;
}

