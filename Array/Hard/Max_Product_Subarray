// Brute force

#include <bits/stdc++.h> 
int maximumProduct(vector<int> &arr, int n)
{
	if(n==1){
		return arr[0];
	}
	int Max=INT_MIN;
	for(int i=0;i<n;i++){
		int ans=1;
		for(int j=i;j<n;j++){
			ans=(ans*arr[j]);
			Max=max(Max,ans);
		}
	}

	return Max;
}

// Optimal approach

#include <bits/stdc++.h> 
int maximumProduct(vector<int> &arr, int n)
{
	if(n==1){
		return arr[0];
	}
	int Max=INT_MIN;
	int prefix=1;
	int suffix=1;
	
	for(int i=0;i<n;i++){
		if(prefix==0){ prefix=1; }
		if(suffix==0){ suffix=1; }

		prefix*=arr[i];
		suffix*=arr[n-i-1];

		int temp=max(prefix,suffix);
		Max=max(Max,temp);
	}

	return Max;
}
