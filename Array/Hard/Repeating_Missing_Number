// Brute force 

vector<int> findRepeatingAndMissingNumbers(vector<int> nums)
{
   int n=nums.size();
   int repeat=0,miss=0;
   
   for(int i=1;i<=n;i++){
       int cnt=0;
       for(int j=0;j<n;j++){
           if(nums[j]==i){
               cnt++;
           }    
       }
            if(cnt==2){ repeat=i; }
           else if(cnt==0){ miss=i; }
   }

   return {repeat,miss};
}

// Better force

vector<int> findRepeatingAndMissingNumbers(vector<int> nums)
{
    int n=nums.size();
   vector<int> hash(n+1,0);
   int missing=0;
   int repeating=0;

   for(int i=0;i<n;i++){
       hash[nums[i]]++;
   }

   for(int i=1;i<=n;i++){
       if(hash[i]==0){
           missing=i;
       }
       else if(hash[i]>1){
           repeating=i;
       }
   }

   return {repeating,missing};
}
