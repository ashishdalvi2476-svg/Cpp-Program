// Brute force 

vector<int> findRepeatingAndMissingNumbers(vector<int> nums)
{
   int n=nums.size();
   int repeat=0,miss=0;
   
   for(int i=1;i<=n;i++){
       int cnt=0;
       for(int j=0;j<n;j++){
           if(nums[j]==i){
               cnt++;
           }    
       }
            if(cnt==2){ repeat=i; }
           else if(cnt==0){ miss=i; }
   }

   return {repeat,miss};
}

// Better approach

vector<int> findRepeatingAndMissingNumbers(vector<int> nums)
{
    int n=nums.size();
   vector<int> hash(n+1,0);
   int missing=0;
   int repeating=0;

   for(int i=0;i<n;i++){
       hash[nums[i]]++;
   }

   for(int i=1;i<=n;i++){
       if(hash[i]==0){
           missing=i;
       }
       else if(hash[i]>1){
           repeating=i;
       }
   }

   return {repeating,missing};
}

// Optimal Approach - I(Using Basic Math)

vector<int> findRepeatingAndMissingNumbers(vector<int> nums)
{

    // will be using simple maths 
    // we should know sum of n natural no. & sum of squares of n natural no.
   long long n=nums.size();
   
   long long Sn=(n*(n+1)/2);
   long long S2n=(n*(n+1)*((2*n)+1))/6;
   long long S1=0,S2=0;

    // calculating the sum of array ele & sum of square of array ele
   for(int i=0;i<n;i++){
       S1+=nums[i];
       long long temp=((long long)nums[i])*((long long)nums[i]);
       S2+=temp;
   }

   // X-Y : x-> repeating , y-> missing
   long long val1=S1-Sn;

   // X^2-Y^2
   long long val2=S2-S2n;

   // Converting into X+Y 
   val2=val2/val1;

   long long x=(val1+val2)/2;
   long long y=val2-x;

   return {(int)x,(int)y};
}
