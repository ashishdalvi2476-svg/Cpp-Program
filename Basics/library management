
#include <iostream>
using namespace std;
struct books{
    int id;
    char name[50];
    char author[50];
    int copies;
};
int count=0;
books library[100];

void add(){
    cout<<"Enter Book Id : "<<endl;
    cin>>library[count].id;
      cin.ignore();
    cout<<"Enter Book Name : "<<endl;
    cin.getline(library[count].name,50);
  
    cout<<"Enter Book Author  Name : "<<endl;
    cin.getline(library[count].author,50);
    
    cout<<"Enter No. Of Copies : "<<endl;
    cin>>library[count].copies;
    
    
    count++;
    cout<<" Added Successfully !! "<<endl;
}
void display(){
    if(count==0){
        cout<<"NO Copies Avalible !! "<<endl;
    }
    
    for(int i=0;i<count;i++){
        cout<<"ID : "<<library[i].id<<endl;
        cout<<"Book Name : "<<library[i].name<<endl;
        cout<<"Author Name :"<<library[i].author<<endl;
        cout<<"Copies : "<<library[i].copies<<endl;
    }
}
void search(){
    int ID;
    cout<<" Enter Id To Search : "<<endl;
    cin>>ID;
if(ID<0){
cout<<" Enter Valid Choice "<<endl;
}
    for(int i=0;i<count;i++){ 
    if(library[i].id==ID){
        cout<<" Found : "<<i<<endl;
    }
}
}
void issue(){
    
    
int issue;
cout<<" Enter Book ID : "<<endl;
cin>>issue;
for(int i=0;i<count;i++){
    
    if(library[i].id==issue && library[i].copies>0){
        library[i].copies--;
        cout<<"Issued Successfully !! "<<endl;
    }
}
}

void return_book(){
    int ret;
cout<<" Enter Book ID : "<<endl;
cin>>ret;
for(int i=0;i<count;i++){
    if(library[i].id==ret && library[i].copies>=0){
        library[i].copies++;
        cout<<"Returned  Successfully !! "<<endl;
    }
}
    
}
int main() {
    int choice;
    do {
        cout << "\n--- Library Management System ---\n";
        cout << "1. Add Book\n";
        cout << "2. Display All Books\n";
        cout << "3. Search Book\n";
        cout << "4. Issue Book\n";
        cout << "5. Return Book\n";
        cout << "6. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch(choice) {
            case 1: add(); break;
            case 2: display(); break;
            case 3:  search(); break;
            case 4: issue(); break;
            case 5: return_book(); break;
            
            default: cout << "Invalid choice\n";
        }
    } while(choice != 6);


    return 0;
}
