// Brute Force solution

class Solution {
public:
    int countGoodNumbers(long long n) {
        int MOD = 1e9 + 7;
      long long ans=1;
        int even=5;
        int prime=4;

        for(int i=0;i<n;i++){
            if(i%2==0){ ans*=even; ans=ans%MOD;}
            else if(i%2==1){ ans*=prime; ans=ans%MOD; }
            else{ break; }
        }

        return (int)ans;
    }
};

This Will Give You TLE as the value of n is very large

class Solution {
public:

    long long Power(long long  x,long long n){
        long long sol=1;
        long long Modulo=1e9+7;

        if(n<0){
            n=-n;
            x=1/x;
        }
        while(n>0){
        if(n%2==1){
            sol*=x;
            sol%=Modulo;
        }
        x=(x*x)%Modulo;
        n=n/2;
        }

        return sol;
    }
    int countGoodNumbers(long long n) {
        long long Mod=1e9+7;
        long long even_cnt=(n/2)+(n%2);
        long long odd_cnt=(n/2);

        return (Power(5,even_cnt)*Power(4,odd_cnt))%Mod;
    }
};
