int Count(vector<int> arr,int k,int idx,int s){
    if(idx>=arr.size()){
        if(s==k){
            return 1;
        }
        return 0;
    }

    s+=arr[idx];
    int l = Count(arr,k,idx+1,s);
    s-=arr[idx];
    int r = Count(arr,k,idx+1,s);

    return l+r;
}

int findWays(vector<int>& arr, int k)
{
	int ans=Count(arr,k,0,0);
    return ans;
}
