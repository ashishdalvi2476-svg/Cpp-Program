class Solution {
public:

    void Generate(vector<string>& ans,string s,int open,int close,int n){
        if((open==n && close==n)){
            ans.push_back(s);
            s="(";
            return;
        }

        if(open<n){
            Generate(ans,s+"(",open+1,close,n);
        }
        if(close<open){
            Generate(ans,s+")",open,close+1,n);
        }
        return;
    }
    vector<string> generateParenthesis(int n) {
         vector<string> ans;
         Generate(ans,"(",1,0,n);

         return ans;
    }
};
