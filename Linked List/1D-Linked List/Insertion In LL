#include <bits/stdc++.h>
using namespace std;

class Node{
  public:
  int data;
  Node* next;
  
  Node(int data1,Node* next1){
      data=data1;
      next=next1;
  }
  Node(int data1){
      data=data1;
      next=NULL;
  }
};

Node* ArrayToLL(vector<int> arr){
    Node* head=new Node(arr[0]);
    Node* ptr=head;
    
    for(int i=1;i<arr.size();i++){
        Node* temp=new Node(arr[i]);
        ptr->next=temp;
        ptr=temp;
    }
    
    return head;
}

