#include<bits/stdc++.h>
using namespace std;
class Node{
    public:
    int data;
    Node* next;

    Node(int data1,Node* next1){
        data=data1;
        next=next1;
    }
    Node(int data1){
        data=data1;
    }
};

Node*  Convert_Arr_to_LL(vector<int> arr){
    Node* head=new Node(arr[0]);
    Node* Move=head;
    
    for(int i=1;i<arr.size();i++){
        Node* temp=new Node(arr[i]);
        Move->next=temp;
        Move=temp;
    }
    
    return head;
}
int main()
{
   vector<int> arr{1,2,3,4};
   Node* head=Convert_Arr_to_LL(arr);
   cout<<head->data;

return 0;
}
