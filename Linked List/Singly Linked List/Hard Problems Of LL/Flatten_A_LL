// Brute force

#include<bits/stdc++.h>
/*
 * Definition for linked list.
 * class Node {
 *  public:
 *		int data;
 *		Node *next;
 * 		Node *child;
 *		Node() : data(0), next(nullptr), child(nullptr){};
 *		Node(int x) : data(x), next(nullptr), child(nullptr) {}
 *		Node(int x, Node *next, Node *child) : data(x), next(next), child(child) {}
 * };
 */

Node* Convert(vector<int>& arr){
	Node* NEW=new Node(arr[0]);
	Node* curr=NEW;

	for(int i=1;i<arr.size();i++){
		Node* temp=new Node(arr[i]);
		curr->child=temp;
		curr=temp;
	}

	return NEW;
}
Node* flattenLinkedList(Node* head) 
{
	vector<int> arr;
	Node* temp1=head;
	while(temp1!=NULL){
		Node* temp2=temp1;
		while(temp2!=NULL){
			arr.push_back(temp2->data);
			temp2=temp2->child;
		}

		temp1=temp1->next;
	}

	sort(arr.begin(),arr.end());
	Node* newhead=Convert(arr);
	return newhead;
}


// optimal solution

/*
 * Definition for linked list.
 * class Node {
 *  public:
 *		int data;
 *		Node *next;
 * 		Node *child;
 *		Node() : data(0), next(nullptr), child(nullptr){};
 *		Node(int x) : data(x), next(nullptr), child(nullptr) {}
 *		Node(int x, Node *next, Node *child) : data(x), next(next), child(child) {}
 * };
 */

Node* Merge(Node* list1,Node* list2){
	if(list1==NULL){ return list2; }
	if(list2==NULL){ return list1; }

	Node* t1=list1;
	Node* t2=list2;
	Node* dummy=new Node(-1);
	Node* curr=dummy;

	while(t1!=NULL && t2!=NULL){
		if(t1->data<=t2->data){
			curr->child=t1;
			curr=t1;
			t1=t1->child;
		}
		else{
			curr->child=t2;
			curr=t2;
			t2=t2->child;
		}
	}

	if(t1!=NULL){ curr->child=t1; }
	else{ curr->child=t2; }

	return dummy->child;
}

Node* flattenLinkedList(Node* head) 
{
	if(head==NULL || head->next==NULL){ return head; }
	Node* merged=NULL;
	
	merged=flattenLinkedList(head->next);
	merged=Merge(head,merged);

	return merged;

}
