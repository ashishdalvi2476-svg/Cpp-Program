// Brute Force

/*
// Definition for a Node.
class Node {
public:
    int val;
    Node* next;
    Node* random;
    
    Node(int _val) {
        val = _val;
        next = NULL;
        random = NULL;
    }
};
*/

class Solution {
public:
    Node* copyRandomList(Node* head) {
        Node* temp=head;

      // Inserting Dummy node in between the nodes

        while(temp!=NULL){
            Node* copy1=new Node(temp->val);
            copy1->next=temp->next;
            temp->next=copy1;
            temp=temp->next->next;
        }

        temp=head;
      // Connecting the next pointers of copy

        while(temp!=NULL){
            Node* copy2=temp->next;
            if(temp->random!=NULL){
            copy2->random=temp->random->next;
            }
            else{
                 copy2->random=NULL;
            }
            temp=temp->next->next;
        }

        temp=head;
      // Connecting the next pointers
        Node* dummy=new Node(-1);
        Node* curr=dummy;
        while(temp!=NULL){
            Node* copy3=temp->next;
            curr->next=copy3;
            curr=copy3;
            temp->next=temp->next->next;
            temp=temp->next;
        }

        return dummy->next;
    }
};

