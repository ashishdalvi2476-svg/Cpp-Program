string reverseString(string &str){
	string ans="";
	int i=str.size()-1;
	
	while(i>=0){
	while(i>=0 && str[i]==' '){
		i--;
	}
	if(i<0){ break; }
	
	int end=i;
	while(i>=0 && str[i]!=' '){
		i--;
	}
	string temp=str.substr(i+1,end-i);



	if(ans.empty()){ ans+=temp; }
	else{ ans+=" "+temp; }
	}

	return ans;
}
