// Approach - I

class Solution{	
	public:
		bool anagramStrings(string& s,string t){
            if(s.size()!=t.size()){ return false;}

			sort(s.begin(),s.end());
            sort(t.begin(),t.end());

        if(s==t){ return true; }

        return false;
		}
};

// Approach - II

class Solution{	
	public:
		bool anagramStrings(string& s,string t){
            if(s.size()!=t.size()){ return false;}

            int fre[26]={0};
            for(int i=0;i<s.size();i++){
                fre[s[i]-'a']++;
                fre[t[i]-'a']--;
            }

            for(int i=0;i<26;i++){
                if(fre[i]>0){
                    return false;
                }
            }

            return true;
		}
};
