// Stack Based Approach

#include<bits/stdc++.h>
class Solution {
public:
    int maxDepth(string s) {
       stack<char> st;
       int result=0;

       for(char ch:s){
        if(ch=='('){
            st.push(ch);
            result=max(result,(int)st.size());
        }
        else if(ch==')'){
            st.pop();
        }
       } 

       return result;
    }
};

// Counter Based Approach

class Solution {
public:
    int maxDepth(string s) {
        int ans = 0, cnt = 0;

        for (int i = 0; i < s.size(); i++) {
            if (s[i] == '(') {
                cnt += 1;
            } else if (s[i] == ')') {
                cnt-=1;
            }

            ans = max(ans, cnt);
        }

        return ans;
    }
};
