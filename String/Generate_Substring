#include <bits/stdc++.h> 
#include <iostream>
#include <cstring>
using namespace std;

void printSubstrings(string input) {
    for(int i=0;i<input.size();i++){
            string ans="";
        for(int j=i;j<input.size();j++){
            ans+=input[j];
            cout<<ans<<endl;
        }
    }
}

int main() {
    string input;
    getline(cin, input);
    printSubstrings(input);
    return 0;
}
