#include<bits/stdc++.h>
typedef pair<char,int> P;
string sortByFrequency(int n, string& s)
{
	vector<P> vec(123);

    for(int i=0;i<n;i++){
        int fre=vec[s[i]].second;
        char ch=s[i];
        vec[ch]={ch,fre+1};
    }

    auto lambda=[&](P p1,P p2){ return p1.second>p2.second; };

    sort(vec.begin(),vec.end(),lambda);

    string ans="";
    for(int i=0;i<vec.size();i++){
        if(vec[i].second>0){
        char ch=vec[i].first;
        int temp=vec[i].second;
        ans+=string(temp,ch);
        }
    }

    return ans;
}
