int createAtoi(string s) {
    long long ans=0;
    int idx=1;
    int i=0;

    while(i<s.size() && s[i]==' '){ i++; }

    if(i<s.size() && (s[i]=='+' || s[i]=='-')){
        idx=(s[i]=='+')? 1:-1;
        i++;
    }

    while(i<s.size() && s[i]=='0'){ i++; }

    while(i<s.size() && (s[i]>='0' && s[i]<='9')){
        ans=(ans*10)+(s[i]-'0');

        if((ans*idx)<=INT_MIN){ return INT_MIN; }
        if((ans*idx)>=INT_MAX){ return INT_MAX; }

        i++;
    }

    return (int)ans*idx;
}
